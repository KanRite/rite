{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "riteui",
  "identifier": "io.github.kanrite.riteui",
  "build": {
    "frontendDist": "../rite-ui-web/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../rite-ui-web"
    },
    "beforeBuildCommand": {
      "script": "trunk build --release",
      "cwd": "../rite-ui-web"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "riteui",
        "width": 1600,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
